# Copy to .env (gitignored) and fill in. Never commit real values.
# Contact address sent in the User-Agent of API requests so servers can identify us.
CONTACT_EMAIL=
# Optional: raises NCBI E-utilities rate limits. Free at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
# BacDive requires a free account (https://bacdive.dsmz.de/). Needed only if the API is used.
BACDIVE_EMAIL=
BACDIVE_PASSWORD=
